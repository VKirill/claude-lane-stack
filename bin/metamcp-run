#!/usr/bin/env bash
# Hybrid MetaMCP launcher — child servers from ~/.agents/metamcp.mcp.json
set -euo pipefail
AGENTS_HOME="${AGENTS_HOME:-$HOME/.agents}"
# shellcheck disable=SC1091
[[ -f "$AGENTS_HOME/metamcp.env" ]] && source "$AGENTS_HOME/metamcp.env"
# fallback bearer from bashrc if missing
if [[ -z "${SELFY_MCP_BEARER:-}" && -f "$HOME/.bashrc" ]]; then
  # shellcheck disable=SC1090
  eval "$(grep -E '^export SELFY_MCP_BEARER=' "$HOME/.bashrc" | head -1)" || true
fi
export PATH="$HOME/.npm-global/bin:$AGENTS_HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:${PATH:-/usr/bin}"
CFG="$AGENTS_HOME/metamcp.mcp.json"
if command -v metamcp >/dev/null 2>&1; then
  exec metamcp --config "$CFG" "$@"
fi
if [[ -x "$HOME/.npm-global/bin/metamcp" ]]; then
  exec "$HOME/.npm-global/bin/metamcp" --config "$CFG" "$@"
fi
if [[ -f "$HOME/mcp_server/metamcp/dist/index.js" ]]; then
  exec node "$HOME/mcp_server/metamcp/dist/index.js" --config "$CFG" "$@"
fi
exec npx -y @mentu/metamcp@1.0.0 --config "$CFG" "$@"
