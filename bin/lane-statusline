#!/usr/bin/env python3
"""Claude Code statusLine router for Claude Lane Stack.

- **Normal Claude Code** (no lane agent) → standard **claude-pulse** (full user config).
- **dev-orchestrator** (and other lane agents) → native lane HUD (S/W/C + peak + HANDOFF chip).

Wired as the single `statusLine.command` so install does not replace pulse globally
for everyday coding sessions.

Env:
  LANE_STATUSLINE_ENGINE=auto|lane|pulse
      auto (default) — pulse unless agent_type is a lane agent
      lane           — always native HUD
      pulse          — always claude-pulse
  LANE_STATUSLINE_AGENTS  comma list (default: dev-orchestrator,frontend-orchestrator,
                          run-supervisor,lane-supervisor)
  LANE_STATUSLINE_MODE=compact|bars|chip|full  (lane HUD only)
  CLAUDE_PULSE_STATUS     path to claude_status.py
  LANE_STATUSLINE_CACHE   native last-usage cache dir
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
if str(BIN) not in sys.path:
    sys.path.insert(0, str(BIN))

from lane_statusline_lib import build_status_line, use_lane_hud  # noqa: E402

PULSE_CANDIDATES = (
    os.environ.get("CLAUDE_PULSE_STATUS"),
    str(Path.home() / ".claude-pulse" / "claude_status.py"),
    "/home/ubuntu/.claude-pulse/claude_status.py",
)


def _pulse_script() -> Path | None:
    for cand in PULSE_CANDIDATES:
        if not cand:
            continue
        path = Path(cand).expanduser()
        if path.is_file():
            return path
    return None


def _run_pulse(raw: str) -> str:
    """Invoke stock claude-pulse with the user's real config (no overlay)."""
    script = _pulse_script()
    if script is None:
        return ""
    try:
        proc = subprocess.run(
            [sys.executable, str(script)],
            input=raw,
            capture_output=True,
            text=True,
            timeout=4,
            # full user env / XDG_CONFIG — do not inject compact overlay
            env=os.environ.copy(),
        )
        return (proc.stdout or "").rstrip("\n")
    except (OSError, subprocess.TimeoutExpired):
        return ""


def main() -> int:
    raw = sys.stdin.read()

    if use_lane_hud(raw):
        mode = (os.environ.get("LANE_STATUSLINE_MODE") or "compact").strip().lower()
        line = build_status_line(raw, mode=mode)
        sys.stdout.write(line.rstrip("\n") + "\n")
        return 0

    # Standard Claude Code session → claude-pulse as-is
    pulse_out = _run_pulse(raw)
    if pulse_out:
        sys.stdout.write(pulse_out.rstrip("\n") + "\n")
        return 0

    # Pulse missing: stay quiet-minimal (do not force lane bars on normal sessions)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
