#!/usr/bin/env python3
"""Classify a search-query intent via Jev. Not a writer."""
from __future__ import annotations

import json
import sys
from pathlib import Path

_BIN = Path(__file__).resolve().parent
if str(_BIN) not in sys.path:
    sys.path.insert(0, str(_BIN))

from jev_decisions import JevCritiqueError
from jev_slots import classify_intent


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    query = " ".join(args).strip()
    if not query:
        print("usage: jev-intent <query>", file=sys.stderr)
        return 2
    try:
        print(json.dumps(classify_intent(query), ensure_ascii=False))
    except JevCritiqueError as exc:
        print(f"jev-intent: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
