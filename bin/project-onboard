run_onboard_fill() {
  local art="$REPO/.agents/runs/_onboard/artifacts/001"
  mkdir -p "$art"
  local prompt="$art/prompt.md"
  local final="$art/codex-final.md"
  local log="$art/codex-exec.log"
  local instr="${HOME}/.agents/codex/instructions/onboard.md"
  [[ -f "$instr" ]] || instr="/home/ubuntu/tools/claude-lane-stack/agents/codex/instructions/onboard.md"
  local schemas="${HOME}/.claude/skills/project-onboard/references/PACK-SCHEMAS.md"
  local validation="${HOME}/.claude/skills/project-onboard/references/VALIDATION.md"
  local design_std="${HOME}/.claude/skills/project-onboard/references/design-md-standard.md"
  local timeout_s=1200
  [[ "$DEPTH" == "deep" ]] && timeout_s=3600
  [[ -n "${ONBOARD_TIMEOUT:-}" ]] && timeout_s="$ONBOARD_TIMEOUT"

  if [[ ! -f "$instr" ]]; then
    echo "ERROR: missing onboard instructions: $instr" >&2
    return 1
  fi

  # Ensure artifact dir is writable for the model (chmod in case of odd umask).
  chmod -R u+rwX "$art" 2>/dev/null || true
  mkdir -p "$art"
  : >"$art/.writable"
  rm -f "$art/.writable"

  local app_pack_bin="${HOME}/.agents/bin/onboard_app_packs.py"
  [[ -f "$app_pack_bin" ]] || app_pack_bin="/home/ubuntu/tools/claude-lane-stack/bin/onboard_app_packs.py"
  local apps_n=0
  if [[ -x "$app_pack_bin" || -f "$app_pack_bin" ]]; then
    apps_n="$(python3 "$app_pack_bin" list "$REPO" 2>/dev/null | wc -l | tr -d ' ')"
  elif [[ -d "$REPO/apps" ]]; then
    apps_n="$(find "$REPO/apps" -mindepth 2 -maxdepth 2 -name package.json 2>/dev/null | wc -l | tr -d ' ')"
  fi
  # Two-pass pipeline when deep monorepo: root pack first, then per-app packs.
  local two_pass=0
  if [[ "$DEPTH" == "deep" && "${apps_n:-0}" -ge 2 ]]; then
    two_pass=1
  fi

  local prompt_root="$art/prompt-root.md"
  local prompt_apps="$art/prompt-phase4b.md"

  cat > "$prompt_root" <<EOF
You are project-onboarder. Follow these instructions exactly:

1. Read and obey: $instr
2. Schemas (MUST): $schemas
3. Validation (MUST before STATUS complete): $validation
4. If has_ui=1: $design_std

PROJECT_CWD=$REPO
ARTIFACT_DIR=$art
ARTIFACT_DIR_REL=.agents/runs/_onboard/artifacts/001
ONBOARD_SCENARIO=$SCENARIO
ONBOARD_DEPTH=$DEPTH
ONBOARD_SERVICE_TIER=$ONBOARD_SERVICE_TIER
has_ui=$HAS_UI
has_deploy=$HAS_DEPLOY
ONBOARD_PIPELINE_PASS=root

Phase 0 seed already ran. Do NOT re-run agents-doctor. Do NOT rewrite .agents/routing.profile.yaml.

Writable roots: git worktree including docs/** and .agents/runs/_onboard/artifacts/001/**.
Write RELATIVE phase files:
  .agents/runs/_onboard/artifacts/001/phase1-layout.md
  .agents/runs/_onboard/artifacts/001/phase2-maps.md
  .agents/runs/_onboard/artifacts/001/phase3-flows.md
  .agents/runs/_onboard/artifacts/001/phase4-passport.md
$(if [[ "$two_pass" -eq 1 ]]; then
  echo "STOP after phase4-passport.md. Do NOT write apps/*/docs or phase4b/phase5/report yet — the host pipeline runs a dedicated per-app pass next."
else
  cat <<'EOP'
  .agents/runs/_onboard/artifacts/001/phase4b-app-packs.md
  .agents/runs/_onboard/artifacts/001/phase5-critique.md
  .agents/runs/_onboard/artifacts/001/report.md
Also complete Phase4b per-app packs (filled local CLAUDE+docs; project surfaces; no catch-all stubs) and Phase5 validation.
EOP
fi)

Deep completeness (PACK-SCHEMAS): lean MANIFEST always_load; MODULE_MAP covers apps+runners/hot libs; webhooks per provider; auth resolved; FLOWS notify = stream+queue consumer; decisions.md 3–5 ADRs.

READ SCOPE: apps/ packages/ infra/ scripts/ tests/ docs/ root manifests /.github/workflows.
Do NOT explore: .worktrees/ .git/ node_modules/ dist/ .next/ .nuxt/ coverage/ .agents/runs/ (except ARTIFACT_DIR) .agents/session-log/ .agents/runs-archive/ .codex/ docs/.wiki-backup/

Read package.json via jq/python/cat — never node require without './'.
Seeded stubs: full-file rewrite. English only. Evidence path:line.

End with: DONE phase4-passport   or   FAILED <reason>
EOF
  cp "$prompt_root" "$prompt"

  if [[ "$two_pass" -eq 1 ]]; then
    cat > "$prompt_apps" <<EOF
You are project-onboarder on PIPELINE PASS = per-app packs (Phase4b + Phase5).

1. Obey: $instr (Phase 4b + Phase 5)
2. Schemas: $schemas (Per-app pack quality bar — MUST)
3. Validation: $validation (MUST — refuse thin/catch-all packs)

PROJECT_CWD=$REPO
ARTIFACT_DIR=$art
ARTIFACT_DIR_REL=.agents/runs/_onboard/artifacts/001
ONBOARD_PIPELINE_PASS=phase4b
has_ui=$HAS_UI
has_deploy=$HAS_DEPLOY

Root pack already exists (phase1–4). The host just ran onboard_app_packs prepare:
  - skeletons under apps/*/CLAUDE.md and apps/*/docs/ when missing
  - projected docs/llm/API_SURFACE.yaml → each apps/<name>/docs/llm/API_SURFACE.yaml from root

Your job — sequential walk of each real apps/*:
1. Read that app's code (not only the skeleton).
2. Fill/rewrite local CLAUDE.md + docs/{INDEX,ARCHITECTURE,GOTCHAS} + docs/llm/FLOWS.md to the quality bar (usable alone, path:line).
3. Expand local API_SURFACE from the projection + code: split webhooks per provider; real HTTP/queue families — no catch-all mega-ids.
4. Write .agents/runs/_onboard/artifacts/001/phase4b-app-packs.md with APP_PACKS per app.
5. Run VALIDATION.md checks; write phase5-critique.md + report.md (STATUS complete only if green).

Do NOT weaken root docs/llm maps. Do NOT skip apps because root maps exist.
English only. End with: DONE $art/report.md   or   FAILED <reason>
EOF
  fi

  echo "==> fill: provider=$ONBOARD_PROVIDER model=$ONBOARD_MODEL effort=$ONBOARD_EFFORT tier=$ONBOARD_SERVICE_TIER timeout=${timeout_s}s"
  echo "    pipeline: $([[ "$two_pass" -eq 1 ]] && echo "two-pass (root → app-packs)" || echo "single-pass")"
  echo "    apps_for_packs=$apps_n"
  echo "    prompt=$prompt"
  echo "    log=$log"
  : >"$log"

  if [[ "${ONBOARD_DRY_RUN:-}" == "1" ]]; then
    echo "DRY_RUN: skip model exec"
    echo "$ONBOARD_PROVIDER $ONBOARD_MODEL $ONBOARD_EFFORT $ONBOARD_SERVICE_TIER" > "$art/dry-run.txt"
    return 0
  fi

  _onboard_tui_bin() {
    local c
    for c in \
      "${HOME}/.agents/bin/onboard_fill_tui.py" \
      "/home/ubuntu/tools/claude-lane-stack/bin/onboard_fill_tui.py" \
      "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "$0")")/onboard_fill_tui.py"
    do
      [[ -f "$c" ]] && { echo "$c"; return 0; }
    done
    return 1
  }

  # Run writer → log; TTY gets split-pane TUI (left checklist / right log).
  # ONBOARD_PLAIN=1 → classic tee stream.
  _onboard_run_writer() {
    local -a wcmd=("$@")
    local use_tui=0 tui=""
    if [[ -t 1 && -z "${ONBOARD_PLAIN:-}" ]]; then
      tui="$(_onboard_tui_bin || true)"
      [[ -n "$tui" ]] && use_tui=1
    fi

    # Optional stdin file for Codex (`-`); Cursor gets prompt as argv.
    local stdin_file="${ONBOARD_WRITER_STDIN:-}"

    set +e
    if [[ "$use_tui" -eq 1 ]]; then
      echo "    UI: split-pane TUI (ONBOARD_PLAIN=1 for raw stream)"
      if [[ -n "$stdin_file" ]]; then
        if command -v stdbuf >/dev/null 2>&1; then
          timeout "$timeout_s" stdbuf -oL -eL "${wcmd[@]}" <"$stdin_file" >>"$log" 2>&1 &
        else
          timeout "$timeout_s" "${wcmd[@]}" <"$stdin_file" >>"$log" 2>&1 &
        fi
      else
        if command -v stdbuf >/dev/null 2>&1; then
          timeout "$timeout_s" stdbuf -oL -eL "${wcmd[@]}" >>"$log" 2>&1 &
        else
          timeout "$timeout_s" "${wcmd[@]}" >>"$log" 2>&1 &
        fi
      fi
      local wpid=$!
      echo "$wpid" >"$art/writer.pid"
      python3 "$tui" \
        --repo "$REPO" \
        --art "$art" \
        --log "$log" \
        --pid "$wpid" \
        --has-ui "$HAS_UI" \
        --has-deploy "$HAS_DEPLOY" \
        --model "$ONBOARD_MODEL"
      wait "$wpid"
      local rc=$?
    else
      local hb=0
      (
        while true; do
          sleep 30
          local newest
          newest="$(ls -1t "$art"/phase*.md "$art"/report.md 2>/dev/null | head -1 || true)"
          if [[ -n "$newest" ]]; then
            echo "[onboard] still running… latest=$(basename "$newest") $(date -u +%H:%M:%SZ)"
          else
            echo "[onboard] still running… waiting for phase1-layout.md $(date -u +%H:%M:%SZ)"
          fi
        done
      ) &
      hb=$!
      if [[ -n "$stdin_file" ]]; then
        if command -v stdbuf >/dev/null 2>&1; then
          timeout "$timeout_s" stdbuf -oL -eL "${wcmd[@]}" <"$stdin_file" 2>&1 | tee -a "$log"
        else
          timeout "$timeout_s" "${wcmd[@]}" <"$stdin_file" 2>&1 | tee -a "$log"
        fi
      else
        if command -v stdbuf >/dev/null 2>&1; then
          timeout "$timeout_s" stdbuf -oL -eL "${wcmd[@]}" 2>&1 | tee -a "$log"
        else
          timeout "$timeout_s" "${wcmd[@]}" 2>&1 | tee -a "$log"
        fi
      fi
      local rc=${PIPESTATUS[0]}
      kill "$hb" 2>/dev/null || true
      wait "$hb" 2>/dev/null || true
    fi
    set -e
    return "$rc"
  }

  _onboard_provider_once() {
    local prompt_file="$1"
    local pass_label="$2"
    local rc_local=0
    echo "==> model pass: $pass_label (prompt=$(basename "$prompt_file"))"
    case "$ONBOARD_PROVIDER" in
      codex)
        command -v codex >/dev/null 2>&1 || { echo "ERROR: codex not in PATH" >&2; return 1; }
        # danger-full-access: workspace-write rejects some in-repo writes under
        # .agents/ (gitignored / dockerignored) as "outside of the project".
        local -a cmd=(
          codex exec
          --model "$ONBOARD_MODEL"
          -c "model_reasoning_effort=\"$ONBOARD_EFFORT\""
          -c 'approval_policy="never"'
          --sandbox danger-full-access
          --skip-git-repo-check
          --cd "$REPO"
          --output-last-message "$final"
        )
        if [[ "$ONBOARD_SERVICE_TIER" == "fast" ]]; then
          cmd+=(-c 'service_tier="fast"' --enable fast_mode)
        else
          cmd+=(--disable fast_mode)
        fi
        cmd+=(-)
        ONBOARD_WRITER_STDIN="$prompt_file" _onboard_run_writer "${cmd[@]}" || rc_local=$?
        echo "    codex exit=$rc_local ($pass_label) log=$log"
        [[ -f "$final" ]] && echo "    last-message: $final"
        ;;
      cursor)
        command -v cursor-agent >/dev/null 2>&1 || { echo "ERROR: cursor-agent not in PATH" >&2; return 1; }
        local cmodel="$ONBOARD_MODEL"
        if [[ "$ONBOARD_SERVICE_TIER" == "fast" && "$cmodel" != *-fast ]]; then
          cmodel="${cmodel}-fast"
        fi
        _onboard_run_writer cursor-agent -p --force --trust --approve-mcps \
          --sandbox disabled \
          --workspace "$REPO" \
          --model "$cmodel" \
          --output-format stream-json \
          "$(cat "$prompt_file")" || rc_local=$?
        echo "    cursor-agent exit=$rc_local ($pass_label) log=$log"
        ;;
      *)
        echo "ERROR: stages.onboard provider='$ONBOARD_PROVIDER' not supported for --run (use codex|cursor)" >&2
        return 1
        ;;
    esac
    return "$rc_local"
  }

  local rc=0
  _onboard_provider_once "$prompt_root" "root-pack" || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "ERROR: onboard root pass failed (exit $rc). See $log" >&2
    return "$rc"
  fi

  if [[ "$two_pass" -eq 1 ]]; then
    echo "==> pipeline: prepare app-pack skeletons + project surfaces from root API_SURFACE"
    if [[ -f "$app_pack_bin" ]]; then
      python3 "$app_pack_bin" prepare "$REPO" || {
        echo "ERROR: onboard_app_packs prepare failed" >&2
        return 1
      }
    else
      echo "WARN: onboard_app_packs.py missing — phase4b model pass without projection" >&2
    fi
    echo "" >>"$log"
    echo "===== PHASE4B PASS =====" >>"$log"
    _onboard_provider_once "$prompt_apps" "phase4b-app-packs" || rc=$?
    if [[ $rc -ne 0 ]]; then
      echo "ERROR: onboard phase4b pass failed (exit $rc). See $log" >&2
      return "$rc"
    fi
  fi

  # Host-side gate: pack validation must pass for deep monorepo complete.
  if [[ "$DEPTH" == "deep" && -f "$validation" ]]; then
    echo "==> pipeline: host VALIDATION gate"
    local val_log="$art/validation-host.log"
    set +e
    (
      cd "$REPO" || exit 1
      export ARTIFACT_DIR="$art"
      # Extract first bash fence from VALIDATION.md and run it.
      python3 - <<'PY' "$validation" >"$art/validation-host.sh"
from pathlib import Path
import sys
text = Path(sys.argv[1]).read_text(encoding="utf-8")
start = text.find("```bash")
end = text.find("```", start + 7) if start >= 0 else -1
if start < 0 or end < 0:
    raise SystemExit("no bash block in VALIDATION.md")
print(text[start + 7 : end].lstrip("\n"))
PY
      bash "$art/validation-host.sh"
    ) >"$val_log" 2>&1
    local vrc=$?
    set -e
    if [[ $vrc -ne 0 ]]; then
      echo "ERROR: VALIDATION gate failed (exit $vrc). See $val_log" >&2
      tail -n 40 "$val_log" >&2 || true
      return "$vrc"
    fi
    echo "    VALIDATION gate ok → $val_log"
  fi

  if [[ -f "$art/report.md" ]]; then
    echo "==> fill complete: $art/report.md"
  else
    echo "==> fill finished (no report.md yet — check $log / $final)"
  fi
}

if [[ "$RUN_FILL" -eq 1 ]]; then
  run_onboard_fill
else
  echo "  Seed-only mode (no model). Full pipeline: project-onboard ."
  echo "  Weekly refresh: docs-maintainer with ONBOARD_REFRESH=weekly"
fi
