# Deep scan evidence pack for Codex (always useful; required reading when depth=deep)
write_deep_scan() {
  local out="$REPO/.agents/runs/_onboard/artifacts/001/deep-scan.md"
  mkdir -p "$(dirname "$out")"
  # pipefail + find|head → SIGPIPE(141); never abort onboard for evidence pack
  set +e
  set +o pipefail
  {
    echo "# Deep scan evidence (auto) — for project-onboarder"
    echo ""
    echo "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "Scenario: \`$SCENARIO\` · Depth: \`$DEPTH\` · Score: $DETECTED_SCORE"
    echo ""
    echo "## Top-level"
    echo '```'
    ls -la "$REPO" 2>/dev/null | head -60
    echo '```'
    echo ""
    echo "## Git status (short)"
    echo '```'
    git -C "$REPO" status --short 2>/dev/null | head -80 || echo "(not a git repo)"
    echo '```'
    echo ""
    echo "## Recent commits"
    echo '```'
    git -C "$REPO" log --oneline -15 2>/dev/null || true
    echo '```'
    echo ""
    echo "## Likely entrypoints / package manifests"
    echo '```'
    find "$REPO" -maxdepth 4 -type f \
      \( -name 'main.rs' -o -name 'main.go' -o -name 'main.py' -o -name 'index.ts' \
         -o -name 'index.js' -o -name 'app.ts' -o -name 'server.ts' -o -name 'instrumentation.ts' \
         -o -name 'package.json' -o -name 'Cargo.toml' -o -name 'pyproject.toml' \
         -o -name 'go.mod' -o -name 'Dockerfile' -o -name 'docker-compose.yml' \
         -o -name 'docker-compose.yaml' -o -name 'ecosystem.config.js' -o -name 'Makefile' \) \
      -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/target/*' \
      -not -path '*/.next/*' -not -path '*/dist/*' -not -path '*/.worktrees/*' \
      2>/dev/null | head -80
    echo '```'
    echo ""
    echo "## Largest source files (approx LOC)"
    echo '```'
    find "$REPO" -type f \
      \( -name '*.rs' -o -name '*.ts' -o -name '*.tsx' -o -name '*.py' -o -name '*.go' -o -name '*.js' \) \
      -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/target/*' \
      -not -path '*/.next/*' -not -path '*/dist/*' -not -path '*/vendor/*' \
      -not -path '*/.worktrees/*' -not -path '*/.agents/*' 2>/dev/null \
      | head -400 \
      | xargs -r wc -l 2>/dev/null \
      | sort -nr \
      | head -25
    echo '```'
    echo ""
    echo "## Docs index"
    echo '```'
    find "$REPO/docs" -name '*.md' 2>/dev/null | head -60 || echo "(no docs/)"
    echo '```'
    echo ""
    echo "## Scripts / verify hints"
    echo '```'
    if [[ -f "$REPO/package.json" ]]; then
      python3 -c "import json;d=json.load(open('$REPO/package.json'));print(json.dumps(d.get('scripts',{}),indent=2))" 2>/dev/null || true
    fi
    [[ -f "$REPO/rust-sync/Cargo.toml" ]] && echo "rust-sync/Cargo.toml present — try: cd rust-sync && cargo test"
    [[ -f "$REPO/Cargo.toml" ]] && echo "Cargo.toml present — try: cargo test"
    [[ -f "$REPO/pyproject.toml" ]] && echo "pyproject — try: pytest -q"
    echo '```'
    echo ""
    echo "## Codex deep multi-phase pipeline (mandatory when depth=deep)"
    echo ""
    echo "Standards: AGENTS.md + CLAUDE.md + llms.txt + Diátaxis TAXONOMY + docs/llm/*.yaml"
    echo "has_ui=$HAS_UI has_deploy=$HAS_DEPLOY refresh=weekly"
    echo ""
    echo "Write each artifact under this directory (RELATIVE paths) before the next phase:"
    echo "  .agents/runs/_onboard/artifacts/001/phase1-layout.md"
    echo "  .agents/runs/_onboard/artifacts/001/phase2-maps.md   → MODULE_MAP covers apps+runners; webhooks per provider"
    echo "  .agents/runs/_onboard/artifacts/001/phase3-flows.md  → include notify stream+queue consumer when present"
    echo "  .agents/runs/_onboard/artifacts/001/phase4-passport.md → lean MANIFEST always_load + 3–5 ADRs"
    echo "  .agents/runs/_onboard/artifacts/001/phase4b-app-packs.md → per-app CLAUDE+docs (pipeline pass 2)"
    echo "  .agents/runs/_onboard/artifacts/001/phase5-critique.md → VALIDATION.md (ARTIFACT_DIR set)"
    echo "  .agents/runs/_onboard/artifacts/001/report.md"
  } > "$out"
  set -e
  set -o pipefail
  echo "    wrote $out"
}

write_deep_scan

