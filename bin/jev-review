#!/usr/bin/env python3
"""jev-review — staged Jev review of a git diff. Not a writer."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_BIN = Path(__file__).resolve().parent
if str(_BIN) not in sys.path:
    sys.path.insert(0, str(_BIN))

from jev_decisions import JevCritiqueError
from jev_review import JevReviewBlock, review_changes


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--project-cwd", default=".")
    parser.add_argument("--base", default=None, help="git diff base (default: HEAD + staged)")
    parser.add_argument("--out", default=None, help="write JSON receipt here")
    parser.add_argument(
        "--gate",
        action="store_true",
        help="exit 1 when Jev asks for request_changes",
    )
    args = parser.parse_args(argv)
    repo = Path(args.project_cwd).expanduser().resolve()
    if not repo.is_dir():
        print(f"jev-review: not a directory: {repo}", file=sys.stderr)
        return 2
    try:
        report = review_changes(repo, base=args.base)
    except JevCritiqueError as exc:
        print(f"jev-review: {exc}", file=sys.stderr)
        return 2
    text = json.dumps(report, indent=2, ensure_ascii=False)
    if args.out:
        out = Path(args.out)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text + "\n", encoding="utf-8")
    print(text)
    if args.gate and report.get("verdict") == "request_changes":
        print("jev-review: request_changes", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except JevReviewBlock as exc:
        print(f"jev-review: {exc}", file=sys.stderr)
        raise SystemExit(1)
