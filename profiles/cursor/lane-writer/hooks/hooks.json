{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./scripts/before_shell.py",
        "failClosed": false
      }
    ],
    "subagentStart": [
      {
        "command": "./scripts/subagent_start.py",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "./scripts/before_read.py",
        "failClosed": false,
        "timeout": 15
      }
    ]
  }
}
